{
  "name": "soldev",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/libs/*",
    "packages/services/*",
    "packages/web/*",
    "packages/templates/*"
  ],
  "packageManager": "yarn@4.7.0",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "postinstall": "husky",
    "generate:web-app": "node scripts/generate-web-app.ts",
    "remove:web-app": "node scripts/remove-web-app.ts",
    "typecheck:scripts": "tsc -p tsconfig.json",
    "run:template": "yarn workspace @templates/web dev",
    "build:template": "yarn workspace @templates/web build",
    "lint:template": "yarn workspace @templates/web lint",
    "typecheck:template": "yarn workspace @templates/web typecheck",
    "docker:template:build": "docker build -f hosting/docker/_web-template/Dockerfile --build-arg APP_DIR=packages/templates/web --build-arg APP_NAME=@templates/web -t soldev-web-template .",
    "docker:template:run": "docker run --rm -p 8080:80 soldev-web-template",
    "docker:template:verify": "APP_DIR=packages/templates/web APP_NAME=@templates/web bash hosting/docker/_web-template/verify-docker.sh",
    "run:client": "yarn workspace @web/client dev",
    "build:client": "yarn workspace @web/client build",
    "lint:client": "yarn workspace @web/client lint",
    "typecheck:client": "yarn workspace @web/client typecheck",
    "docker:client:build": "docker build -f hosting/docker/client/Dockerfile -t soldev-client .",
    "docker:client:verify": "bash hosting/docker/client/verify-docker.sh",
    "run:admin": "yarn workspace @web/admin dev",
    "build:admin": "yarn workspace @web/admin build",
    "lint:admin": "yarn workspace @web/admin lint",
    "typecheck:admin": "yarn workspace @web/admin typecheck",
    "docker:admin:build": "docker build -f hosting/docker/admin/Dockerfile -t soldev-admin .",
    "docker:admin:verify": "bash hosting/docker/admin/verify-docker.sh"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0"
  }
}
