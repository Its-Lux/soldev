# Base URL for API requests. Leave blank in development: requests and the
# MSW mock handlers both build on this value, so they always match. Set it
# for real builds, for example as a Docker build argument.
VITE_API_BASE_URL=
VITE_ENV_MODE=
# Google Maps, used by shared/ui/map. Restrict the key by HTTP referrer.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=